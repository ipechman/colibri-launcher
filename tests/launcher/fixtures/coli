#!/usr/bin/env python3
import json
import argparse
import os
import sys
from pathlib import Path


HERE = Path(__file__).resolve().parent


def _support_dir():
    installed = HERE.parent / "libexec" / "colibri"
    return installed if installed.is_dir() else HERE


sys.path.insert(0, str(_support_dir()))
from family_registry import resolve_model


def engine_for(model):
    family = resolve_model(model).descriptor
    return str(_support_dir() / family.engine_artifact)


def cuda_binary(engine=None):
    if engine is None:
        return False
    return any(Path(str(engine) + suffix).is_file() for suffix in (".cuda", ".hip"))


def dsv4_cuda_available(model=None):
    return Path(engine_for(model) + ".dsv4").is_file()


def _argument(name, default=None):
    try:
        return sys.argv[sys.argv.index(name) + 1]
    except (ValueError, IndexError):
        return default


def _doctor():
    (_support_dir() / "doctor-called").touch()
    model = Path(_argument("--model", ""))
    config = json.loads((model / "config.json").read_text(encoding="utf-8"))
    if config.get("doctor_schema") == "bad":
        print(json.dumps({"schema_version": 2, "checks": []}))
        return 0
    resolved = resolve_model(model)
    family = resolved.descriptor
    engine = Path(engine_for(model))
    checks = [
        {"id": "model.path", "status": "pass", "summary": "model directory is readable"},
        {"id": "model.family", "status": "pass", "summary": "family registered",
         "details": {"family_id": family.id}},
        {"id": "engine.binary", "status": "pass" if engine.is_file() else "fail",
         "summary": "engine executable is ready" if engine.is_file() else "engine is not built"},
    ]
    gpu = _argument("--gpu", "auto")
    devices = json.loads(os.environ.get("FAKE_GPU_DATA", "[]"))
    available = {int(item["index"]) for item in devices}
    if gpu == "none":
        checks.append({"id": "accelerator.gpu", "status": "skip",
                       "summary": "GPU use was explicitly disabled"})
    else:
        requested = available if gpu == "auto" else {int(value) for value in gpu.split(",")}
        if not requested.issubset(available):
            checks.append({"id": "accelerator.gpu", "status": "fail",
                           "summary": "one or more requested GPUs were not detected"})
        elif config.get("gpu_runtime_missing"):
            checks.append({"id": "accelerator.gpu", "status": "fail",
                           "summary": "GPU runtime library is missing"})
        elif family.supports_accelerator and (cuda_binary(engine) or
                (family.id == "deepseek_v4" and dsv4_cuda_available(model))) and requested:
            checks.append({"id": "accelerator.gpu", "status": "pass",
                           "summary": "GPU engine and devices are available"})
        else:
            checks.append({"id": "accelerator.gpu", "status": "warn",
                           "summary": "GPU detected but the engine is CPU-only"})
    override = config.get("doctor_accelerator")
    if override:
        checks = [item for item in checks if item["id"] != "accelerator.gpu"]
        if override != "omit":
            checks.append({"id": "accelerator.gpu", "status": override,
                           "summary": "accelerator diagnostic did not pass"})
    status_values = {item["status"] for item in checks}
    status = "error" if "fail" in status_values else "warning" if "warn" in status_values else "ok"
    print(json.dumps({"schema_version": 1, "status": status, "model": str(model),
                      "mode": "standard", "checks": checks,
                      "plan": {"fixture": True, "gpu": gpu, **_runtime_settings(family)}}))
    return 1 if status == "error" else 0


def _runtime_settings(family):
    # Match the installed CLI precedence used by resource_request/ngen_for.
    limits = family.limits
    context_var = getattr(limits, "context_env", "CTX")
    ram = float(_argument("--ram") or os.environ.get("RAM_GB", "0"))
    return {
        "context": int(_argument("--ctx") or os.environ.get(context_var, limits.default_context)),
        "ram": ram,
        "output": int(_argument("--ngen") or limits.interactive_max_output),
        "expert_gb": os.environ.get("GLM53_EXPERT_GB", str(max(2, ram - 8))),
        "k3_cuda": os.environ.get("K3_CUDA", "0"),
    }


def main():
    config_path = _support_dir() / "fixture_cli.json"
    config = json.loads(config_path.read_text()) if config_path.is_file() else {}
    parser = argparse.ArgumentParser(description="Fixture; --auto-tier may be unavailable")
    parser.add_argument("--version", action="version", version="colibri 9.9.9")
    commands = parser.add_subparsers(dest="command")
    for name in config.get("commands", ("doctor", "web", "serve")):
        command = commands.add_parser(name)
        options = {
            "--model": {}, "--ram": {"type": int}, "--ctx": {"type": int},
            "--gpu": {}, "--vram": {"type": float}, "--ngen": {"type": int},
            "--auto-tier": {"action": "store_true"},
        }
        if name == "doctor":
            options["--json"] = {"action": "store_true"}
        if name in {"web", "serve"}:
            options.update({"--host": {}, "--port": {"type": int}, "--model-id": {}})
        if name == "web":
            options["--no-browser"] = {"action": "store_true"}
        omitted = config.get("omit", {}).get(name, [])
        for option, kwargs in options.items():
            if option not in omitted:
                kwargs.update(config.get("alter", {}).get(name, {}).get(option, {}))
                command.add_argument(option, **kwargs)
        for option in config.get("required", {}).get(name, []):
            command.add_argument(option, required=True)
        for positional in config.get("positionals", {}).get(name, []):
            command.add_argument(positional)
    args = parser.parse_args()
    if args.command == "doctor":
        return _doctor()
    if args.command in {"serve", "web"}:
        family = resolve_model(_argument("--model")).descriptor
        print(json.dumps(_runtime_settings(family)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
